#include <stdio.h>

int main()
{
    int n, i;
    int first = 0, second = 1, next;
    int sum = 0;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    printf("Fibonacci Series:\n");

    for(i = 1; i <= n; i++)
    {
        printf("%d ", first);

        if(first % 2 == 0)
        {
            sum = sum + first;
        }

        next = first + second;
        first = second;
        second = next;
    }

    printf("\n\nSum of even-valued terms = %d", sum);

    return 0;
}
