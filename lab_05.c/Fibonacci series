#include<stdio.h>
int main(){
printf("Narayani roll number 54\n");
int n, num1=0, num2=1, nextnum;
printf("enter number");
scanf("%d",&n);
printf("Fibonacci series\n");

for(int i=1;i<=n;++i){
printf("%d\n",num1);
nextnum = num1+num2;
printf("%d\n",nextnum);
num1 = num2;
printf("%d\n",num1);
num2 = nextnum;
printf("%d\n",num2);
}
return 0;
}
