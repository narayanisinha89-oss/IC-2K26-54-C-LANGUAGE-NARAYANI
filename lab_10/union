#include <stdio.h>

union Student
{
    int roll;
    float marks;
    char grade;
};

int main()
{
    union Student s;

    s.roll = 101;
    printf("Roll Number = %d\n", s.roll);

    s.marks = 89.5;
    printf("Marks = %.2f\n", s.marks);

    s.grade = 'A';
    printf("Grade = %c\n", s.grade);

    return 0;
}
